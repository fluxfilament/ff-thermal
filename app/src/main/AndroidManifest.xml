<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:theme="@style/Theme.FlirOneViewer">

        <!--
            configChanges: recreating the activity tears down the USB connection and
            re-opens it mid-stream, which costs a stall and loses the one-shot
            sledInformation message. A rotation is not worth that.
            keepScreenOn: a live view the user is pointing at things should not time out.
            screenOrientation: the camera is bolted to the phone, so turning the phone
            turns the scene with it and the picture is already where it belongs. A
            window that turned too would move the picture a second time, against a
            scene that never moved. The picture's own rotation is a setting instead,
            and the accelerometer is read for exactly one thing: keeping the spot
            readings upright for whoever is holding it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
    </application>
</manifest>
