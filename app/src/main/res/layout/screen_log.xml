<?xml version="1.0" encoding="utf-8"?>
<!--
    The diagnostics the old status line carried, now that the top bar only has room
    for the state and the geometry. The scene's own minimum and maximum live here as
    well: on the main screen the scale ends say the same thing while contrast is
    automatic, but once the window is pinned they no longer do.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenLog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/logHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/logBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Ff.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/log_title" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/ff_border"
                android:orientation="vertical"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="1dp"
                        android:layout_marginBottom="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/stat_frame"
                            android:textAllCaps="true"
                            android:textColor="@color/ff_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/statFrameValue"
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="1dp"
                        android:layout_marginBottom="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/stat_lepton"
                            android:textAllCaps="true"
                            android:textColor="@color/ff_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/statLeptonValue"
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/stat_stream"
                            android:textAllCaps="true"
                            android:textColor="@color/ff_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/statStreamValue"
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/stat_ffc"
                            android:textAllCaps="true"
                            android:textColor="@color/ff_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/statFfcValue"
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="1dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/stat_resync"
                            android:textAllCaps="true"
                            android:textColor="@color/ff_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/statResyncValue"
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_stat"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="@string/stat_scene"
                            android:textAllCaps="true"
                            android:textColor="@color/ff_muted"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/statSceneValue"
                            style="@style/Ff.Mono"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/logView"
                style="@style/Ff.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_code"
                android:lineSpacingMultiplier="1.45"
                android:padding="16dp"
                android:textColor="#E8ECEF"
                android:textIsSelectable="true"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
