<?xml version="1.0" encoding="utf-8"?>
<!--
    Field of view is a fixed property of the optics, so it belongs on a screen of its
    own where it can be set against a real subject once and left alone. The comparison
    is live rather than a frozen frame: lining two lenses up means moving the camera
    and watching the edges meet.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenFov"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/fovHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/fovBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <TextView
            style="@style/Ff.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:text="@string/fov_title" />

        <TextView
            android:id="@+id/fovReset"
            style="@style/Ff.Mono"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:letterSpacing="0.06"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/fov_reset"
            android:textAllCaps="true"
            android:textColor="@color/ff_accent2"
            android:textSize="12sp" />
    </LinearLayout>

    <com.bikbovdamir.flironeviewer.SplitPreviewView
        android:id="@+id/splitPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_well_outline"
        android:contentDescription="@string/fov_split_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_well_outline">

                <ImageView
                    android:id="@+id/thumbThermal"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                style="@style/Ff.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.04"
                android:text="ИК 80×60"
                android:textColor="@color/ff_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_well_outline">

                <ImageView
                    android:id="@+id/thumbVisible"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <!-- Which part of the wider visible frame the current setting keeps. -->
                <View
                    android:id="@+id/cropRect"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_crop" />
            </FrameLayout>

            <TextView
                style="@style/Ff.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.04"
                android:text="ВИД 1440×1080"
                android:textColor="@color/ff_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                style="@style/Ff.Eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fov_value"
                android:textColor="@color/ff_muted" />

            <TextView
                android:id="@+id/fovValue"
                style="@style/Ff.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Ff.RowSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/fov_default" />
        </LinearLayout>
    </LinearLayout>

    <SeekBar
        android:id="@+id/fovSeek"
        style="@style/Ff.Seek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/fov_description"
        android:max="120"
        android:min="40" />

    <TextView
        style="@style/Ff.Note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="8dp"
        android:text="@string/fov_note" />
</LinearLayout>
