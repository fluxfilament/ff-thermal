<?xml version="1.0" encoding="utf-8"?>
<!--
    One window, six screens, and an overlay for the scale sheet.

    Screens are sibling views rather than separate activities, for one hard reason:
    the USB connection and the camera's one-shot sledInformation message live with
    this activity, and handing the window to another activity risks tearing the stream
    down mid-flight. It also means the field-of-view screen can show live frames
    rather than a frozen one, which is the whole point of a calibration screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ff_bg"
    android:keepScreenOn="true">

    <include layout="@layout/screen_live" />
    <include layout="@layout/screen_settings" />
    <include layout="@layout/screen_emissivity" />
    <include layout="@layout/screen_fov" />
    <include layout="@layout/screen_calibration" />
    <include layout="@layout/screen_log" />

    <!--
        The sheet sits above the legend and the bottom bar rather than over them: the
        scale ends it is editing are in the legend, and covering them would mean
        setting a number while the thing it changes is hidden.
    -->
    <FrameLayout
        android:id="@+id/sheetLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/sheetScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ff_scrim"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:id="@+id/sheetRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="240dp"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sheetTitle"
                    style="@style/Ff.Eyebrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ff_muted" />

                <ImageButton
                    android:id="@+id/sheetClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/close"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/sheetValue"
                    style="@style/Ff.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="42sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sheetStamp"
                    style="@style/Ff.Stamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_stamp_done"
                    android:text="@string/sheet_fixed"
                    android:textColor="@color/ff_accent" />

                <TextView
                    android:id="@+id/sheetHint"
                    style="@style/Ff.Note"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/sheet_will_fix" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sheetSeek"
                style="@style/Ff.Seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:max="170" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-10dp"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <TextView
                    style="@style/Ff.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="−20 °C"
                    android:textColor="@color/ff_muted"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/sheetOther"
                    style="@style/Ff.Mono"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:textColor="@color/ff_muted"
                    android:textSize="10.5sp" />

                <TextView
                    style="@style/Ff.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150 °C"
                    android:textColor="@color/ff_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sheetDone"
                style="@style/Ff.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="12dp"
                android:text="@string/sheet_done" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
