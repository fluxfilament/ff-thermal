<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:keepScreenOn="true">

    <TextView
        android:id="@+id/statusView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:textColor="#DDDDDD" />

    <ImageView
        android:id="@+id/thermalView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="#000000"
        android:scaleType="matrix"
        android:contentDescription="@string/thermal_view_description" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/save_button" />

        <Button
            android:id="@+id/paletteButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <Button
            android:id="@+id/blendButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <Button
            android:id="@+id/mirrorButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />

        <Button
            android:id="@+id/logButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/log_button" />
    </LinearLayout>

    <!--
        Only meaningful while the visible layer is mixed in, so it stays out of the
        way otherwise. Two controls because the two misalignments are different in
        kind: the field-of-view crop is fixed by the optics, the parallax shift moves
        with how far away the subject is.
    -->
    <LinearLayout
        android:id="@+id/overlayControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/fovLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textColor="#DDDDDD" />

            <SeekBar
                android:id="@+id/fovSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:min="40"
                android:max="120" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/alignLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="96dp"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textColor="#DDDDDD" />

            <SeekBar
                android:id="@+id/alignSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:min="0"
                android:max="100" />
        </LinearLayout>
    </LinearLayout>

    <!--
        Emissivity stays on screen rather than behind a settings toggle: it is the
        one number that has to change per target material, and a reading taken at
        the wrong value is wrong without looking wrong.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/emissivityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="#DDDDDD" />

        <SeekBar
            android:id="@+id/emissivitySeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:min="10"
            android:max="100" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/logView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:textColor="#AAAAAA"
            android:textIsSelectable="true" />
    </ScrollView>

</LinearLayout>
