<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup on Android 8.x. These versions cannot tell a cloud backup from a direct
    transfer (requireFlags arrived in Android 9), so nothing is backed up at all.
    Android 9 to 11 use xml-v28/backup_rules.xml, Android 12+ data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
