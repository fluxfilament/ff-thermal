<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup on Android 12 and later.

    Nothing goes to the cloud backup. A direct transfer to a new phone, by cable or
    from the old phone over Wi-Fi, carries everything, so the camera's constants and
    its calibration move with the user. The <device-transfer> section is left out on
    purpose: a missing section means that mode is fully enabled.

    allowBackup="false" alone would not do: on Android 12+ whether it still allows
    device transfer depends on the phone's manufacturer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
</data-extraction-rules>
